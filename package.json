{
  "name": "neobank-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ts-check": "tsc --noEmit --project ./tsconfig.app.json",
    "lint": "eslint --fix .",
    "lint-files": "eslint --fix",
    "format": "prettier --write --ignore-unknown .",
    "format-files": "prettier --write --ignore-unknown",
    "check": "npm run ts-check && npm run lint && npm run format",
    "lint-staged": "lint-staged",
    "postinstall": "echo 'npx lint-staged' > .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit"
  },
  "dependencies": {
    "neobank-ui-kit": "1.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.13.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@hh.ru/eslint-config": "18.1.5",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.0.1"
  }
}
